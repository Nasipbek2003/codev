# Скопируйте этот файл в .env и заполните своими значениями
# ВНИМАНИЕ: не коммитьте реальные креды в этот файл - он отслеживается git

# База данных Neon PostgreSQL (для Prisma с connection pooling)
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require&pgbouncer=true

# Прямое подключение к Neon (для миграций Prisma)
DIRECT_URL=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require

# Anthropic Claude API ключ (для Chat API)
ANTHROPIC_API_KEY=your_anthropic_api_key

# Telegram бот для уведомлений о заявках
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# API ключи
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Отключение телеметрии Next.js
NEXT_TELEMETRY_DISABLED=1

# Добавьте здесь другие переменные окружения, которые использует ваше приложение:
# SMTP_HOST=your_smtp_host
# SMTP_PORT=587
# SMTP_USER=your_email
# SMTP_PASSWORD=your_password
